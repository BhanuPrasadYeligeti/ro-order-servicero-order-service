{
  "name": "ro-order-fullstack",
  "version": "1.0.0",
  "description": "Sales order app: SAPUI5 front end + CAP Node.js backend + approuter (SAP BTP Cloud Foundry)",
  "private": true,
  "engines": {
    "node": "^22.0.0"
  },
  "dependencies": {
    "@sap/cds": "^9",
    "@cap-js/sqlite": "^2",
    "express": "^4",
    "cf-nodejs-logging-support": "7.5.5-beta.1",
    "@sap/opentelemetry-exporter-for-sap-cloud-logging": "0.7.0"
  },
  "optionalDependencies": {
    "@sap/xotel-agent-ext-js": "https://73555000100200018064.npmsrv.cdn.repositories.cloud.sap/@sap/xotel-agent-ext-js/-/xotel-agent-ext-js-2.0.5.tgz"
  },
  "devDependencies": {
    "@sap/cds-dk": "^9"
  },
  "scripts": {
    "start": "NODE_OPTIONS=\"--require ./srv/calm-agent.js\" cds-serve",
    "watch": "cds watch"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": ":memory:"
        }
      },
      "auth": {
        "kind": "dummy"
      }
    },
    "log": {
      "levels": {
        "order-service": "info"
      }
    }
  }
}
