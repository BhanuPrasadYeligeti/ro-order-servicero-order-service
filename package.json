{
  "name": "ro-order-fullstack",
  "version": "1.0.0",
  "description": "Sales order app: SAPUI5 front end + CAP Node.js backend + approuter (SAP BTP Cloud Foundry)",
  "private": true,
  "engines": {
    "node": "^22.0.0"
  },
  "dependencies": {
    "@sap/cds": "^9",
    "@cap-js/sqlite": "^2",
    "express": "^4",
    "@sap/xotel-agent-ext-js": "https://73555000100200018064.npmsrv.cdn.repositories.cloud.sap/@sap/xotel-agent-ext-js/-/xotel-agent-ext-js-2.0.5.tgz",
    "@cap-js/telemetry": "2.0.1",
    "@opentelemetry/exporter-logs-otlp-grpc": "0.219.0"
  },
  "devDependencies": {
    "@sap/cds-dk": "^9"
  },
  "scripts": {
    "start": "node ${NODE_ARGS} ./node_modules/.bin/cds-serve",
    "watch": "cds watch"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": ":memory:"
        }
      },
      "auth": {
        "kind": "dummy"
      },
      "telemetry": {
        "logging": {
          "processor": {
            "module": "@sap/xotel-agent-ext-js",
            "class": "ExmLogProcessor"
          },
          "exporter": {
            "module": "@opentelemetry/exporter-logs-otlp-grpc",
            "class": "OTLPLogExporter"
          }
        }
      }
    },
    "log": {
      "levels": {
        "order-service": "info"
      },
      "[production]": {
        "format": "json"
      }
    }
  }
}
